; Engine configuration file.
config_version=5

[application]

config/name="Futebol de Prego"
config/description="Futebol de prego de bolso: puxe, solte e faça o gol."
config/version="2.0.0"
config/icon="res://assets/icon/icon.png"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(0.07, 0.06, 0.18, 1)
boot_splash/show_image=false
config/quit_on_go_back=false

[autoload]

Save="*res://scripts/autoload/save.gd"
Sfx="*res://scripts/autoload/sfx.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=405
window/size/window_height_override=820
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

theme/custom_font="res://assets/fonts/Baloo2-SemiBold.woff2"
theme/default_font_antialiasing=1

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_2d=1
environment/defaults/default_clear_color=Color(0.07, 0.06, 0.18, 1)
